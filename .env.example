# Copy this file to .env and replace the placeholder with your MongoDB URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/digisafeai?retryWrites=true&w=majority
CONTACT_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
FIRST_ADMIN_NAME=First Administrator
FIRST_ADMIN_EMAIL=admin@example.org
FIRST_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
