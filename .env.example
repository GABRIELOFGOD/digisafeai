# Copy this file to .env.local and replace the placeholder with your MongoDB URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/digisafeai?retryWrites=true&w=majority
CONTACT_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
